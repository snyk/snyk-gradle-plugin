{
  "name": "snyk-gradle-plugin",
  "description": "Snyk CLI Gradle plugin",
  "homepage": "https://github.com/snyk/snyk-gradle-plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/snyk/snyk-gradle-plugin"
  },
  "main": "dist/index.js",
  "directories": {
    "test": "test"
  },
  "files": [
    "dist",
    "lib/init.gradle"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint --color --cache '{lib,test}/**/*.{js,ts}' && prettier --check '{lib,test}/**/*.{js,ts}'",
    "format": "prettier --write '{lib,test}/**/*.{js,ts}'",
    "prepare": "npm run build",
    "test": "tsc -p tsconfig-test.json && npm run test:functional && npm run test:system",
    "test:functional": "jest test/functional/",
    "test:system": "jest --runInBand --testTimeout=150000 test/system/"
  },
  "author": "snyk.io",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/needle": "^2.0.4",
    "@types/node": "^18.11.18.0.0",
    "@types/tmp": "0.2.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@common.js/yocto-queue": "^1.1.1",
    "@snyk/cli-interface": "2.11.3",
    "@snyk/dep-graph": "^1.28.0",
    "@types/debug": "^4.1.4",
    "chalk": "^3.0.0",
    "debug": "^4.1.1",
    "p-map": "^4.0.0",
    "packageurl-js": "^1.0.0",
    "shescape": "1.7.4",
    "tmp": "0.2.1",
    "tslib": "^2.0.0"
  },
  "engines": {
    "node": ">=16"
  }
}
